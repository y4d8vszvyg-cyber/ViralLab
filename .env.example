# Server
PORT=3000
# Speicherort der Datenbank (auf dem Server ein persistentes Volume, z.B. /data)
# DATA_DIR=./data
SESSION_SECRET=bitte-aendern
# PUBLIC_URL=https://virallab.example.com

# KI (ohne Key läuft die eingebaute Offline-Engine)
ANTHROPIC_API_KEY=
# VIRALLAB_MODEL=claude-opus-5-5

# Freemium
FREE_LIMIT=10

# Stripe
# Variante A – Payment Link (Standard, kein API-Schlüssel nötig, nur Webhook):
# STRIPE_PAYMENT_LINK=https://buy.stripe.com/...   # Standard: Test-Link im Code; leer = deaktiviert
# STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/...   # No-Code-Kundenportal für „Abo verwalten“
# Variante B – Checkout über die API (STRIPE_PAYMENT_LINK= leer setzen):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=price_...   # sonst wird ein 9,99 €/Monat-Preis inline erzeugt
# ALLOW_DEMO_UPGRADE=false

# Betreiberangaben für Impressum, Datenschutz, AGB und Widerruf
LEGAL_NAME=
LEGAL_ADDRESS=            # z.B. "Musterstraße 1, 10115 Berlin" (Komma = Zeilenumbruch)
LEGAL_EMAIL=
# LEGAL_PHONE=
# LEGAL_VAT_ID=           # USt-IdNr., falls vorhanden
# LEGAL_SMALL_BUSINESS=true   # Kleinunternehmer nach § 19 UStG
# LEGAL_HOSTER=           # Standard: Render Services, Inc., USA

# E-Mail-Versand für Kündigungsbestätigungen (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=                # z.B. "ViralLab <kontakt@deine-domain.de>"
